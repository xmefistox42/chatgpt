---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
interface Props { title: string; description?: string; noindex?: boolean; type?: 'website' | 'article'; }
const { title, description = site.description, noindex = false, type = 'website' } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — Przekraczamy granice światła` : `${title} | SPEKTRUM · ZUT`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL(site.brand.png, Astro.site).href : undefined;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071020" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/webp" href={site.brand.logo} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content="Logo SPEKTRUM z motywem impulsu, soczewki i widma światła" />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
