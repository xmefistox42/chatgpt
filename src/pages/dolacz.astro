---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';

const steps = [
  { number: '01', title: 'Nazwij swoją ciekawość.', description: 'Pomyśl, co najbardziej Cię interesuje: optyka, lasery, układy pomiarowe czy przesyłanie informacji. Wystarczy punkt wyjścia do rozmowy.', detail: 'Co chcesz lepiej zrozumieć?' },
  { number: '02', title: 'Zacznij od kontaktu.', description: 'Sprawdź aktualny sposób kontaktu przez oficjalne źródła Wydziału Elektrycznego ZUT i zapytaj o działalność koła SPEKTRUM.', detail: 'Przedstaw się i opowiedz o zainteresowaniach.' },
  { number: '03', title: 'Ustal następny krok.', description: 'Dopytaj o aktualne możliwości dołączenia, spotkania i zasady udziału. Zakres zaangażowania oraz dostęp do pracowni ustal z opiekunem.', detail: 'Potwierdź szczegóły bezpośrednio z kołem.' },
];
---

<BaseLayout title="Dołącz" description="Interesuje Cię fotonika, technika laserowa lub teleinformatyka? Dowiedz się, jak rozpocząć rozmowę o dołączeniu do koła SPEKTRUM przy ZUT.">
  <main id="main-content">
    <PageIntro eyebrow="TWOJE MIEJSCE W SPEKTRUM" title="Zacznij od ciekawości." description="Masz pytanie, pomysł albo chcesz lepiej poznać świat fotoniki? To dobry początek rozmowy o działalności w kole." />

    <section class="section" aria-labelledby="join-heading"><div class="container join-intro"><div><p class="eyebrow">POŁĄCZ ZAINTERESOWANIA Z DZIAŁANIEM</p><h2 id="join-heading" class="section-heading">Zobacz, dokąd<br />prowadzi Twoje pytanie.</h2></div><div class="prose"><p>SPEKTRUM to studenckie koło naukowe przy Wydziale Elektrycznym ZUT w Szczecinie. Nasze zainteresowania obejmują fotonikę, technikę laserową i teleinformatykę.</p><p>Nie musisz mieć gotowego projektu, żeby rozpocząć rozmowę. Opowiedz, czego chcesz się nauczyć i jakie tematy przyciągają Twoją uwagę. Szczegółowe warunki dołączenia i aktualne możliwości udziału potwierdzisz bezpośrednio z kołem lub jego opiekunem.</p><a class="text-link" href="/o-nas/">Najpierw poznaj SPEKTRUM <Icon name="arrow-up-right" size={18} /></a></div></div></section>

    <section class="section steps-section" aria-labelledby="steps-heading"><div class="container"><p class="eyebrow">OD CZEGO ZACZĄĆ</p><h2 id="steps-heading" class="section-heading">Trzy proste kroki.</h2><ol class="join-steps">{steps.map((step) => (<li><span class="step-number" aria-hidden="true">{step.number}</span><div class="step-body"><h3>{step.title}</h3><p class="muted">{step.description}</p><p class="step-detail"><Icon name="arrow-right" size={15} />{step.detail}</p></div></li>))}</ol></div></section>

    <section class="section" aria-labelledby="prepare-heading"><div class="container prepare-grid"><div class="prepare-heading"><p class="eyebrow">PRZED PIERWSZĄ ROZMOWĄ</p><h2 id="prepare-heading" class="section-heading">Kilka zdań<br />wystarczy na początek.</h2><p class="muted">Te informacje ułatwią ustalenie, jak możesz zaangażować się w działalność koła.</p></div><div class="prepare-card panel"><ul><li><span class="check-dot" aria-hidden="true"><Icon name="plus" size={18} /></span><div><strong>Przedstaw się</strong><p>Kierunek i etap studiów pomogą dopasować kontekst rozmowy.</p></div></li><li><span class="check-dot" aria-hidden="true"><Icon name="plus" size={18} /></span><div><strong>Wskaż interesujący Cię temat</strong><p>Może to być konkretne zjawisko, technologia albo pytanie, na które szukasz odpowiedzi.</p></div></li><li><span class="check-dot" aria-hidden="true"><Icon name="plus" size={18} /></span><div><strong>Zapytaj o aktualne możliwości</strong><p>Ustal zasady dołączenia, formę zaangażowania oraz ewentualny termin spotkania.</p></div></li></ul></div></div></section>

    <section class="section" aria-labelledby="join-contact-heading"><div class="container"><div class="join-contact"><div><p class="eyebrow">ZACZNIJMY OD ROZMOWY</p><h2 id="join-contact-heading" class="section-heading">Twój następny krok.</h2><p class="muted">Bezpośredni adres kontaktowy koła jest w trakcie potwierdzania. Na stronie kontaktowej znajdziesz oficjalne źródła, przez które możesz zapytać o SPEKTRUM.</p></div><a class="button button-primary" href="/kontakt/">Przejdź do kontaktu <Icon name="arrow-right" size={18} /></a></div></div></section>
  </main>
</BaseLayout>

<style>
  .join-intro{display:grid;grid-template-columns:1fr 1fr;gap:5rem}.join-intro .prose{max-width:40rem}.join-intro .text-link{margin-top:1rem}.steps-section{border-block:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.02)}.join-steps{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3rem;margin:3rem 0 0;padding:0}.join-steps>li{border-top:1px solid rgba(98,220,232,.3);padding-top:1.5rem}.step-number{display:block;color:#62dce8;font:500 .8rem monospace;margin-bottom:2.7rem}.step-body h3{font-size:1.35rem;line-height:1.4;font-weight:500;margin:0 0 1rem;letter-spacing:-.02em}.step-body>.muted{font-size:.93rem;line-height:1.85}.step-detail{display:flex;align-items:flex-start;gap:.6rem;color:#b7d3d8;font-size:.75rem;line-height:1.8;margin-top:1.7rem}.step-detail :global(svg){flex-shrink:0;margin-top:3px;color:#62dce8}.prepare-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:5rem;align-items:start}.prepare-heading>.muted{max-width:25rem;line-height:1.8}.prepare-card{padding:2.25rem}.prepare-card ul{list-style:none;padding:0;margin:0}.prepare-card li{display:flex;gap:1rem;padding:1.5rem 0;border-bottom:1px solid rgba(255,255,255,.1)}.prepare-card li:first-child{padding-top:0}.prepare-card li:last-child{padding-bottom:0;border:0}.check-dot{display:grid;place-items:center;flex-shrink:0;border:1px solid rgba(98,220,232,.2);border-radius:50%;color:#62dce8;width:1.8rem;height:1.8rem}.prepare-card strong{display:block;font-weight:500;font-size:1rem;margin:.1rem 0 .45rem}.prepare-card li p{font-size:.86rem;line-height:1.8;color:#91a5bd;margin:0}.join-contact{padding:3rem;display:flex;align-items:center;justify-content:space-between;gap:3rem;border-radius:1rem;border:1px solid rgba(98,220,232,.25);background:radial-gradient(ellipse at 100% 0,rgba(98,220,232,.075),transparent 65%)}.join-contact>div{max-width:39rem}.join-contact .muted{font-size:.94rem;line-height:1.8;margin-bottom:0}.join-contact .button{flex-shrink:0}
  @media(max-width:950px){.join-intro,.prepare-grid{grid-template-columns:1fr;gap:2rem}.join-steps{grid-template-columns:1fr;gap:2rem}.step-number{margin-bottom:1.4rem}.step-body{max-width:42rem}.join-contact{flex-direction:column;align-items:flex-start;padding:2rem}.join-contact>div{max-width:none}}
</style>
