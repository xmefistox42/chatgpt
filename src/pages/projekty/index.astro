---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => data.published)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

---

<BaseLayout
  title="Projekty"
  description="Projekty Koła Naukowego SPEKTRUM. Odkrywaj zagadnienia z optyki, fotoniki i technologii laserowych."
>
  <main id="main-content">
    <PageIntro
      eyebrow="Od pomysłu do eksperymentu"
      title="Projekty"
      description="Od laserowego kanału plazmowego po wiązki Airy’ego w krysztale. Poznaj cele, metody i aktualny etap naszych projektów."
    />

    <section class="section projects-section" aria-label="Projekty koła">
      <div class="container">
        {
          projects.length > 0 ? (
            <div class="projects-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
          ) : (
            <div class="empty-state panel projects-empty">
              <span class="empty-icon" aria-hidden="true"><Icon name="optics" /></span>
              <p class="eyebrow">Miejsce na nowe odkrycia</p>
              <h2>Każdy projekt zaczyna się od pytania.</h2>
              <p class="muted">
                Opisy projektów opublikujemy, gdy będziemy mogli opowiedzieć o ich
                celach i postępach. Tymczasem poznaj temat lasera femtosekundowego
                lub dołącz do zespołu i wnieś własny pomysł.
              </p>
              <div class="empty-actions">
                <a class="button button-primary" href="/laser-femtosekundowy/">
                  Laser femtosekundowy <Icon name="arrow-up-right" />
                </a>
                <a class="button button-secondary" href="/dolacz/">
                  Dołącz do SPEKTRUM <Icon name="arrow-right" />
                </a>
              </div>
            </div>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .projects-section { padding-top: 0; }
  .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  @media(max-width:700px){.projects-grid{grid-template-columns:1fr}}
  .projects-empty { max-width: 62rem; margin-inline: auto; padding: clamp(2rem, 6vw, 5rem); }
  .empty-icon { display: inline-flex; margin-bottom: 1.5rem; color: var(--color-accent, #8cbaff); }
  .empty-icon :global(svg) { width: 2.75rem; height: 2.75rem; }
  .projects-empty h2 { max-width: 25ch; margin: 0 0 1.25rem; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.15; }
  .projects-empty > .muted { max-width: 65ch; }
  .empty-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
</style>
