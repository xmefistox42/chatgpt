---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import { supervisorProfile as profile } from '../../data/supervisor';
import { site } from '../../data/site';
const source = (id: string) => profile.sources.find(item => item.id === id)!;
const verifiedDate = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(profile.verifiedAt));
const person = {
  '@context': 'https://schema.org', '@type': 'Person',
  name: profile.name, honorificPrefix: 'dr hab. inż.', honorificSuffix: 'prof. ZUT',
  jobTitle: 'Profesor ZUT', description: profile.introduction,
  worksFor: { '@type': 'CollegeOrUniversity', name: site.university, url: site.links.university },
  email: profile.contact.email, telephone: profile.contact.phoneHref,
  knowsAbout: ['Optyka nieliniowa', 'Fotorefrakcja', 'Półprzewodnikowe studnie kwantowe', 'Modelowanie propagacji światła'],
  ...(Astro.site ? { url: new URL(profile.href, Astro.site).href } : {}),
};
---
<BaseLayout title="Andrzej Ziółkowski — opiekun naukowy" description="Poznaj dr. hab. inż. Andrzeja Ziółkowskiego, prof. ZUT: opiekuna SPEKTRUM, badacza optyki nieliniowej i materiałów fotorefrakcyjnych. Biogram i oficjalne źródła.">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  <main id="main-content">
    <PageIntro eyebrow="Opiekun naukowy SPEKTRUM" title="Andrzej Ziółkowski." description={profile.introduction} parent={{ href: '/zespol/', label: 'Zespół' }} />

    <section class="profile-overview container" aria-labelledby="profile-heading">
      <div class="identity-panel panel">
        <div class="identity-art" aria-hidden="true"><span class="identity-initials">AZ</span><span class="identity-orbit"></span><span class="identity-label">OPTYKA · FOTONIKA · MODELOWANIE</span></div>
        <div class="identity-content"><span class="tag">SPEKTRUM · ZUT</span><h2 id="profile-heading">{profile.fullName}</h2><p>{profile.department}<br />{site.faculty}</p><a class="text-link" href={source('bio').url}>Biogram na stronie ZUT <Icon name="arrow-up-right" size={17} /></a></div>
      </div>
      <div class="profile-introduction">
        <p class="eyebrow">OD MATERIAŁU DO SYGNAŁU</p><h2>Jak światło zmienia<br />swoją drogę?</h2>
        <p>Badania Andrzeja Ziółkowskiego dotyczą oddziaływania światła z materiałem — szczególnie wtedy, gdy oświetlenie wpływa na jego właściwości optyczne. To punkt wyjścia do układów, w których można zmieniać sposób prowadzenia i przetwarzania sygnału świetlnego.</p>
        <p class="muted">Jest związany z Wydziałem Elektrycznym ZUT i pełni rolę opiekuna naukowego SPEKTRUM. Biogram uczelni opisuje również jego opiekę nad Pracownią Urządzeń Fotonicznych, utworzoną w ramach Laboratorium Technologii Teleinformatycznych i Fotoniki.</p>
        <a class="source-link" href="#zrodla">Źródła: biogram i informacje Wydziału Elektrycznego <Icon name="arrow-right" size={14} /></a>
      </div>
    </section>

    <section class="section research-section" aria-labelledby="research-heading"><div class="container">
      <div class="profile-section-heading"><div><p class="eyebrow">OBSZARY BADAŃ</p><h2 id="research-heading">Światło. Materiał.<br />Wzajemne oddziaływanie.</h2></div><p>Zakres badań przedstawiony w oficjalnym biogramie habilitacyjnym ZUT z 2023 roku.</p></div>
      <div class="research-grid">{profile.research.map((item, index) => <article class="research-card"><div class="research-top"><span>0{index + 1}</span><Icon name={item.icon} size={30} /></div><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
      <a class="source-link" href={source('bio').url}>Przeczytaj opis dorobku w biogramie ZUT <Icon name="arrow-up-right" size={14} /></a>
    </div></section>

    <section class="section container" aria-labelledby="history-heading"><div class="history-grid">
      <div><p class="eyebrow">DROGA NAUKOWA</p><h2 id="history-heading">Doświadczenie<br />budowane latami.</h2><p class="muted history-note">Najważniejsze etapy potwierdzone przez uczelnię. Obecne stanowisko profesora ZUT wskazuje aktualna strona katedry.</p><a class="text-link" href={source('habilitation').url}>Dokumentacja habilitacji <Icon name="arrow-up-right" size={17} /></a></div>
      <ol class="timeline">{profile.timeline.map(item => <li><time datetime={item.date}>{item.label ?? item.date}</time><h3>{item.title}</h3><p>{item.description}</p><a class="source-link" href={source(item.source).url}>Źródło ZUT <Icon name="arrow-up-right" size={14} /></a></li>)}</ol>
    </div></section>

    <section class="section collaboration-section" aria-labelledby="collaboration-heading"><div class="container collaboration-grid">
      <div><p class="eyebrow">WSPÓŁPRACA NAUKOWA</p><h2 id="collaboration-heading">Badania łączą<br />różne ośrodki.</h2><p class="muted">Biogram z 2023 r. wymienia współpracę teoretyczną i eksperymentalną z zespołami następujących instytucji.</p><a class="source-link" href={source('bio').url}>Źródło: biogram habilitacyjny <Icon name="arrow-up-right" size={14} /></a></div>
      <ul class="collaboration-list">{profile.collaborations.map((name, index) => <li><span>0{index + 1}</span><h3>{name}</h3><Icon name="network" size={21} /></li>)}</ul>
    </div></section>

    <section class="section container" aria-labelledby="engagement-heading">
      <div class="profile-section-heading"><div><p class="eyebrow">NAUKA I SPOŁECZNOŚĆ</p><h2 id="engagement-heading">Wiedza, którą<br />warto przekazywać.</h2></div><p>Opieka nad studentami, popularyzacja fizyki światła i praca na rzecz środowiska akademickiego.</p></div>
      <div class="engagement-grid">
        <article class="panel engagement-card"><Icon name="spark" size={27} /><h3>Opieka nad SPEKTRUM</h3><p>Oficjalna strona wydziału wskazuje Andrzeja Ziółkowskiego jako opiekuna naukowego koła. SPEKTRUM działa w obszarze fotoniki i jej zastosowań w telekomunikacji optycznej.</p><a class="source-link" href={source('club').url}>Koło na stronie wydziału <Icon name="arrow-up-right" size={14} /></a></article>
        <article class="panel engagement-card"><Icon name="wave" size={27} /><h3>Popularyzacja nauki</h3><p>Biogram opisuje otwarte wykłady dla młodzieży oraz udział w organizacji Polskiej Konferencji Optycznej i warsztatów Nonlinear Optics Applications.</p><a class="source-link" href={source('bio').url}>Biogram ZUT <Icon name="arrow-up-right" size={14} /></a></article>
        <article class="panel engagement-card"><Icon name="network" size={27} /><h3>Dydaktyka i działalność akademicka</h3><p>Jest wymieniony w Komisji Programowej kierunku Elektrotechnika oraz w publikowanym przez ZUT składzie Rady Dyscypliny Automatyka, Elektronika, Elektrotechnika i Technologie Kosmiczne.</p><div class="engagement-links"><a class="source-link" href={source('teaching').url}>Komisja programowa <Icon name="arrow-up-right" size={14} /></a><a class="source-link" href={source('council').url}>Rada dyscypliny <Icon name="arrow-up-right" size={14} /></a></div></article>
      </div>
    </section>

    <section class="section contact-section" id="kontakt" aria-labelledby="contact-heading"><div class="container profile-contact-grid">
      <div><p class="eyebrow">KONTAKT SŁUŻBOWY</p><h2 id="contact-heading">Porozmawiajmy<br />o fotonice.</h2><p class="muted">Dane opiekuna opublikowane przez Katedrę Telekomunikacji i Fotoniki. Terminy konsultacji ustalaj bezpośrednio.</p><a class="source-link" href={source('department').url}>Aktualne dane na stronie katedry <Icon name="arrow-up-right" size={14} /></a></div>
      <address class="profile-contact panel"><dl><div><dt><Icon name="mail" size={18} /> E-mail służbowy</dt><dd><a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a></dd></div><div><dt><Icon name="globe" size={18} /> Telefon służbowy</dt><dd><a href={`tel:${profile.contact.phoneHref}`}>{profile.contact.phone}</a></dd></div><div><dt><Icon name="pin" size={18} /> Siedziba katedry</dt><dd>{profile.contact.address}<br />Pokój {profile.contact.office}</dd></div></dl></address>
    </div></section>

    <section class="section container sources-section" id="zrodla" aria-labelledby="sources-heading"><p class="eyebrow">ŹRÓDŁA I AKTUALNOŚĆ</p><h2 id="sources-heading">Informacje z pierwszej ręki.</h2><p class="sources-intro">Profil opracowany na podstawie publicznych stron ZUT. Informacje organizacyjne sprawdzono <time datetime={profile.verifiedAt}>{verifiedDate}</time>. Opis drogi naukowej, badań i współpracy opiera się na biogramie z 9 listopada 2023 r.</p><ol class="sources-list">{profile.sources.map(item => <li><a href={item.url}><span>{item.label}<small>{item.publisher}</small></span><Icon name="arrow-up-right" size={17} /></a></li>)}</ol><div class="profile-bottom-links"><a class="text-link" href="/zespol/"><Icon name="arrow-right" size={17} /> Wróć do zespołu</a><a class="button button-secondary" href="/projekty/">Poznaj projekty SPEKTRUM <Icon name="arrow-up-right" size={17} /></a></div></section>
  </main>
</BaseLayout>
<style>
  .profile-overview{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;padding-bottom:90px}.identity-panel{overflow:hidden}.identity-art{height:230px;position:relative;display:grid;place-items:center;background:radial-gradient(ellipse at center,#20395a80,transparent 70%),#0b172a;overflow:hidden}.identity-initials{font:400 96px/1 var(--font-heading);letter-spacing:-.07em;color:#c3dcf9;position:relative;z-index:1}.identity-orbit{position:absolute;width:190px;height:190px;border:1px solid #6f9fbb55;border-radius:50%;transform:rotate(-20deg) scaleX(1.35)}.identity-orbit:after{content:'';position:absolute;inset:22px;border:1px solid #a497dd44;border-radius:50%}.identity-label{position:absolute;bottom:20px;font-size:8px;letter-spacing:.18em;color:#a4bdd8}.identity-content{padding:30px}.identity-content h2{font-size:clamp(24px,2.4vw,31px);line-height:1.35;margin:18px 0 14px}.identity-content>p{color:var(--muted);font-size:12px;line-height:1.9}.identity-content .text-link{font-size:12px}.profile-introduction>h2{font-size:40px;margin-bottom:24px}.profile-introduction>p:not(.eyebrow){font-size:14px;line-height:1.95}.source-link{display:inline-flex;align-items:center;gap:9px;min-height:36px;font-size:11px;color:#b4cadf;line-height:1.6}.source-link:hover{color:var(--cyan)}.source-link :global(svg){color:var(--cyan)}.research-section,.collaboration-section,.contact-section{background:#0c1628;border-block:1px solid var(--line)}.profile-section-heading{display:flex;align-items:end;gap:55px;justify-content:space-between;margin-bottom:40px}.profile-section-heading h2{margin-bottom:0;font-size:clamp(30px,3.4vw,45px)}.profile-section-heading>p{color:var(--muted);font-size:13px;max-width:340px;line-height:1.9;margin-bottom:0}.research-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-left:1px solid var(--line);border-block:1px solid var(--line);margin-bottom:18px}.research-card{padding:25px;border-right:1px solid var(--line);min-width:0}.research-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:38px;color:var(--cyan)}.research-top>span{font-size:10px;color:#a2b2cb}.research-card h3{font-size:21px;line-height:1.3;min-height:58px;margin-bottom:20px}.research-card>p{font-size:12px;line-height:1.9;color:var(--muted);margin:0}.history-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px}.history-grid h2{font-size:42px}.history-note{max-width:350px;font-size:13px;line-height:1.9}.timeline{list-style:none;padding:0;margin:0;border-left:1px solid #3c4e6b}.timeline li{position:relative;padding:0 0 37px 32px}.timeline li:last-child{padding-bottom:0}.timeline li:before{content:'';position:absolute;left:-4px;top:9px;width:7px;height:7px;border:1px solid var(--cyan);background:var(--bg);border-radius:50%}.timeline time{display:block;font:12px var(--font-heading);color:var(--cyan);margin-bottom:16px}.timeline h3{font-size:24px;margin-bottom:13px}.timeline p{font-size:13px;color:var(--muted);line-height:1.9;margin-bottom:5px}.collaboration-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px}.collaboration-grid h2{font-size:40px}.collaboration-grid>div>.muted{max-width:350px;font-size:13px;line-height:1.9}.collaboration-list{list-style:none;margin:0;padding:0}.collaboration-list li{display:flex;gap:18px;align-items:center;padding:24px 0;border-top:1px solid var(--line)}.collaboration-list li:last-child{border-bottom:1px solid var(--line)}.collaboration-list li>span{font-size:10px;color:var(--muted)}.collaboration-list h3{font-size:19px;line-height:1.5;letter-spacing:-.025em;flex:1;margin:0}.collaboration-list :global(svg){color:#92b6d4}.engagement-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.engagement-card{padding:30px;display:flex;flex-direction:column;align-items:flex-start}.engagement-card>:global(svg){color:var(--cyan);margin-bottom:30px}.engagement-card h3{font-size:24px;line-height:1.3;margin-bottom:18px}.engagement-card p{font-size:13px;line-height:1.9;color:var(--muted);margin-bottom:20px}.engagement-card>.source-link,.engagement-links{margin-top:auto}.engagement-links{display:flex;flex-direction:column;align-items:flex-start;gap:5px}.profile-contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.profile-contact-grid h2{font-size:42px}.profile-contact-grid .muted{font-size:13px;max-width:350px;line-height:1.9}.profile-contact{font-style:normal;padding:30px}.profile-contact dl{margin:0}.profile-contact dl>div{padding-bottom:24px;margin-bottom:24px;border-bottom:1px solid var(--line)}.profile-contact dl>div:last-child{padding:0;margin:0;border:0}.profile-contact dt{display:flex;gap:10px;align-items:center;font-size:11px;color:#a2b8ce;margin-bottom:13px}.profile-contact dt :global(svg){color:var(--cyan)}.profile-contact dd{font-size:14px;line-height:1.9;margin:0;overflow-wrap:anywhere}.profile-contact dd>a{display:inline-block;min-height:35px}.sources-section h2{font-size:34px}.sources-intro{color:var(--muted);font-size:13px;max-width:760px;line-height:1.9;margin-bottom:32px}.sources-list{padding:0;list-style:none;max-width:900px;counter-reset:sources}.sources-list li{counter-increment:sources}.sources-list a{display:flex;align-items:center;gap:18px;border-top:1px solid var(--line);padding:17px 0;font-size:12px}.sources-list a:before{content:counter(sources,decimal-leading-zero);color:#8fa4c0;font-size:10px}.sources-list a>span{flex:1}.sources-list small{display:block;font-size:10px;color:var(--muted);margin-top:5px;line-height:1.7}.sources-list :global(svg){color:var(--cyan)}.profile-bottom-links{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-top:45px;padding-top:30px;border-top:1px solid var(--line)}.profile-bottom-links>.text-link>:global(svg){transform:rotate(180deg)}
  @media(max-width:1050px){.profile-overview{gap:38px}.research-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.research-card:nth-child(n+3){border-top:1px solid var(--line)}.research-card h3{min-height:0}.history-grid,.collaboration-grid{gap:50px}.engagement-grid{grid-template-columns:1fr}.engagement-card{padding:28px}.engagement-card>:global(svg){margin-bottom:20px}.profile-contact-grid{gap:40px}}
  @media(max-width:760px){.profile-overview,.history-grid,.collaboration-grid,.profile-contact-grid{grid-template-columns:1fr;gap:35px}.profile-overview{padding-bottom:65px}.identity-art{height:200px}.profile-introduction>h2,.history-grid h2,.collaboration-grid h2,.profile-contact-grid h2{font-size:34px}.profile-section-heading{flex-direction:column;align-items:flex-start;gap:20px}.profile-section-heading>p{max-width:100%}.timeline{margin-left:4px}.profile-contact-grid .muted{max-width:100%}.profile-bottom-links{align-items:flex-start;flex-direction:column}.collaboration-grid>div>.muted,.history-note{max-width:100%}}
  @media(max-width:479px){.identity-content{padding:24px}.identity-content h2{font-size:25px}.research-grid{grid-template-columns:1fr}.research-card:nth-child(n+2){border-top:1px solid var(--line)}.research-card{padding:24px}.research-top{margin-bottom:24px}.research-card h3{font-size:24px}.research-card p{font-size:13px}.timeline li{padding-left:24px}.timeline h3{font-size:22px}.collaboration-list h3{font-size:17px}.collaboration-list li{gap:13px}.engagement-card,.profile-contact{padding:24px}.sources-section h2{font-size:29px}}
</style>
