---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { supervisor } from '../data/team';
---

<BaseLayout title="Kontakt" description="Kontakt ze Studenckim Kołem Naukowym SPEKTRUM przy Wydziale Elektrycznym ZUT w Szczecinie. Oficjalne źródła i informacje o zapleczu koła.">
  <main id="main-content">
    <PageIntro eyebrow="POROZMAWIAJMY" title="Dobry pomysł zaczyna się od kontaktu." description="Pytanie o koło, zainteresowanie fotoniką lub chęć dołączenia? Tutaj znajdziesz informacje, od których warto zacząć." />

    <section class="section" aria-labelledby="contact-heading"><div class="container contact-grid"><div><p class="eyebrow">STUDENCKIE KOŁO NAUKOWE</p><h2 id="contact-heading" class="section-heading">SPEKTRUM</h2><p class="contact-affiliation">Wydział Elektryczny<br />Zachodniopomorski Uniwersytet Technologiczny w Szczecinie</p><div class="contact-place"><Icon name="pin" size={20} /><span>Szczecin, Polska</span></div><div class="contact-supervisor"><p class="eyebrow">OPIEKUN NAUKOWY</p><p><a href={supervisor.profileUrl}>{supervisor.name}</a></p><a class="text-link" href={`${supervisor.profileUrl}#kontakt`}>Biogram i kontakt służbowy <Icon name="arrow-up-right" size={16} /></a></div></div><aside class="contact-notice panel" aria-labelledby="notice-heading"><div class="notice-icon" aria-hidden="true"><Icon name="mail" size={28} /></div><span class="tag">INFORMACJA KONTAKTOWA</span><h3 id="notice-heading">{site.contactEmail ? 'Porozmawiajmy o świetle.' : <>Bezpośredni kontakt<br />jest w przygotowaniu.</>}</h3>{site.contactEmail ? <><p class="muted">Napisz do nas, jeśli chcesz poznać koło, dołączyć do zespołu lub porozmawiać o fotonice.</p><a class="button button-primary" href={`mailto:${site.contactEmail}`}>{site.contactEmail} <Icon name="arrow-up-right" size={18} /></a></> : <><p class="muted">Adres e-mail koła i aktualne kanały kontaktu wymagają potwierdzenia. Gdy zostaną zatwierdzone, udostępnimy je w tym miejscu.</p><p class="muted">Do tego czasu skorzystaj z oficjalnej strony Wydziału Elektrycznego ZUT, aby znaleźć aktualne dane kontaktowe i zapytać o koło SPEKTRUM.</p><a class="button button-primary" href={site.links.faculty} target="_blank" rel="noopener noreferrer">Przejdź na stronę wydziału <Icon name="arrow-up-right" size={18} /><span class="sr-only"> — otwiera się w nowej karcie</span></a></>}</aside></div></section>

    <section class="section official-section" aria-labelledby="official-heading"><div class="container"><div class="official-top"><div><p class="eyebrow">SPRAWDZONE PUNKTY ODNIESIENIA</p><h2 id="official-heading" class="section-heading">Oficjalne źródła.</h2></div><p class="muted">Aktualnych informacji organizacyjnych szukaj na stronach uczelni i wydziału.</p></div><div class="official-links"><a href={site.links.university} target="_blank" rel="noopener noreferrer"><div class="official-icon" aria-hidden="true"><Icon name="globe" size={25} /></div><div><span>UCZELNIA</span><h3>Zachodniopomorski Uniwersytet<br />Technologiczny w Szczecinie</h3><p>Oficjalny serwis ZUT</p></div><Icon name="arrow-up-right" size={25} /><span class="sr-only"> — otwiera się w nowej karcie</span></a><a href={site.links.faculty} target="_blank" rel="noopener noreferrer"><div class="official-icon" aria-hidden="true"><Icon name="globe" size={25} /></div><div><span>WYDZIAŁ</span><h3>Wydział Elektryczny</h3><p>Aktualności i dane kontaktowe wydziału</p></div><Icon name="arrow-up-right" size={25} /><span class="sr-only"> — otwiera się w nowej karcie</span></a></div></div></section>

    <section class="section" aria-labelledby="contact-topics-heading"><div class="container contact-topics"><div><p class="eyebrow">ZANIM NAPISZESZ</p><h2 id="contact-topics-heading" class="section-heading">Znajdź dobry<br />punkt wyjścia.</h2></div><div class="topic-links"><a href="/dolacz/"><span><strong>Chcę dołączyć do koła</strong><small>Jak przygotować się do pierwszego kontaktu</small></span><Icon name="arrow-right" size={22} /></a><a href="/laboratorium/"><span><strong>Interesuje mnie laboratorium</strong><small>Zaplecze naukowe i informacje o pracowni</small></span><Icon name="arrow-right" size={22} /></a><a href="/o-nas/"><span><strong>Chcę poznać SPEKTRUM</strong><small>Kim jesteśmy i jakie tematy nas interesują</small></span><Icon name="arrow-right" size={22} /></a></div></div></section>
  </main>
</BaseLayout>

<style>
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem}.contact-grid>.contact-affiliation{max-width:30rem}.contact-affiliation{font-size:1.1rem;line-height:1.85;color:#b8c5d7;max-width:29rem}.contact-place{display:flex;align-items:center;gap:.65rem;color:#91a5bd;font-size:.85rem;margin:1.6rem 0 3rem}.contact-place :global(svg){color:#62dce8}.contact-supervisor{padding-top:1.8rem;border-top:1px solid rgba(255,255,255,.12);max-width:30rem}.contact-supervisor>p:last-child{font-size:1.05rem;line-height:1.7;margin:.8rem 0 0}.contact-notice{padding:2.5rem;position:relative;background:radial-gradient(ellipse at 100% 0,rgba(98,220,232,.07),transparent 70%)}.notice-icon{display:grid;place-items:center;width:3.5rem;height:3.5rem;border:1px solid rgba(98,220,232,.25);border-radius:.75rem;color:#62dce8;margin-bottom:2rem}.contact-notice h3{font-size:clamp(1.7rem,3vw,2.2rem);line-height:1.25;font-weight:500;letter-spacing:-.035em;margin:1.2rem 0 1.4rem}.contact-notice>.muted{font-size:.88rem;line-height:1.85;margin:1rem 0}.contact-notice .button{margin-top:1rem;font-size:.83rem}.official-section{border-block:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.02)}.official-top{display:flex;align-items:end;justify-content:space-between;gap:3rem;margin-bottom:2.5rem}.official-top>p{max-width:23rem;line-height:1.8}.official-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.official-links>a{display:grid;grid-template-columns:auto 1fr auto;gap:1.3rem;align-items:start;padding:2rem;border:1px solid rgba(255,255,255,.12);border-radius:.8rem;color:inherit;text-decoration:none;transition:border-color .2s,background .2s}.official-links>a:hover{border-color:rgba(98,220,232,.4);background:rgba(98,220,232,.03)}.official-icon{color:#62dce8;padding-top:.15rem}.official-links>a>div:nth-child(2)>span{font-size:.6rem;letter-spacing:.12em;color:#91a5bd}.official-links h3{font-size:1.15rem;line-height:1.55;font-weight:500;margin:.7rem 0}.official-links p{color:#91a5bd;font-size:.8rem;line-height:1.7;margin:0}.official-links>a>:global(svg){color:#62dce8;flex-shrink:0}.contact-topics{display:grid;grid-template-columns:.9fr 1.1fr;gap:5rem}.topic-links{border-top:1px solid rgba(255,255,255,.15)}.topic-links>a{display:flex;align-items:center;justify-content:space-between;gap:2rem;border-bottom:1px solid rgba(255,255,255,.15);padding:1.7rem 0;color:inherit;text-decoration:none}.topic-links strong{display:block;font-size:1.1rem;font-weight:500;margin-bottom:.5rem}.topic-links small{display:block;font-size:.78rem;line-height:1.7;color:#91a5bd}.topic-links :global(svg){color:#62dce8;flex-shrink:0}.topic-links>a:hover strong{color:#62dce8}
  @media(max-width:950px){.contact-grid,.contact-topics{grid-template-columns:1fr;gap:2.5rem}.official-top{display:block}.official-top>p{max-width:none}.official-links{grid-template-columns:1fr}.contact-notice{padding:2rem}.contact-notice .button{max-width:100%;white-space:normal}.official-links>a{padding:1.5rem;gap:1rem}}
</style>
