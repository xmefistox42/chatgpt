---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const fields = [
  { number: '01', title: 'Fotonika', icon: 'optics', description: 'Światło jako narzędzie pomiaru, nośnik informacji i punkt wyjścia do eksperymentów.' },
  { number: '02', title: 'Technika laserowa', icon: 'laser', description: 'Źródła promieniowania, układy optyczne oraz poznawanie właściwości krótkich impulsów.' },
  { number: '03', title: 'Teleinformatyka', icon: 'network', description: 'Przesyłanie informacji i technologie, które łączą zjawiska fizyczne z systemami komunikacji.' },
] as const;
---

<BaseLayout title="O nas" description="Poznaj Studenckie Koło Naukowe SPEKTRUM działające przy Wydziale Elektrycznym ZUT w Szczecinie. Fotonika, lasery i teleinformatyka.">
  <main id="main-content">
    <PageIntro eyebrow="POZNAJ SPEKTRUM" title="Ciekawość ma wiele długości fal." description="Łączy nas zainteresowanie światłem, technologią i tym, co można odkryć, zadając kolejne pytanie." />

    <section class="section" aria-labelledby="about-heading">
      <div class="container about-split">
        <div>
          <p class="eyebrow">KIM JESTEŚMY</p>
          <h2 id="about-heading" class="section-heading">Od pytania<br />do eksperymentu.</h2>
        </div>
        <div class="prose about-copy">
          <p>Studenckie Koło Naukowe <strong>SPEKTRUM</strong> działa przy Wydziale Elektrycznym Zachodniopomorskiego Uniwersytetu Technologicznego w Szczecinie.</p>
          <p>Naszym zapleczem jest Laboratorium Technologii Teleinformatycznych i Fotoniki. To kontekst dla zainteresowań koła: od zjawisk optycznych i techniki laserowej po przesyłanie informacji.</p>
          <p>Chcemy, aby wiedza z zajęć stawała się punktem wyjścia do własnych pytań, rozumienia aparatury i świadomego planowania eksperymentów. Pierwszym krokiem może być po prostu ciekawość.</p>
          <a class="text-link" href="/laboratorium/">Poznaj nasze zaplecze <Icon name="arrow-up-right" size={18} /></a>
        </div>
      </div>
    </section>

    <section class="section fields-section" aria-labelledby="fields-heading">
      <div class="container">
        <div class="section-top">
          <div><p class="eyebrow">OBSZARY ZAINTERESOWAŃ</p><h2 id="fields-heading" class="section-heading">Światło. Sygnał. Informacja.</h2></div>
          <p class="muted section-note">Trzy perspektywy, które spotykają się w jednym miejscu.</p>
        </div>
        <div class="fields-grid">
          {fields.map((field) => (
            <article class="field-card">
              <div class="field-top"><span class="field-number">{field.number}</span><Icon name={field.icon} size={34} /></div>
              <h3>{field.title}</h3>
              <p class="muted">{field.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="context-heading">
      <div class="container context-grid">
        <div class="context-heading"><p class="eyebrow">NASZE OTOCZENIE</p><h2 id="context-heading" class="section-heading">Część akademickiej<br />społeczności.</h2><p class="muted">SPEKTRUM łączy studencką ciekawość z naukowym zapleczem uczelni.</p></div>
        <div class="context-list">
          <a href={site.links.university} target="_blank" rel="noopener noreferrer"><span><small>UCZELNIA</small><strong>Zachodniopomorski Uniwersytet Technologiczny w Szczecinie</strong></span><Icon name="arrow-up-right" size={24} /><span class="sr-only"> — otwiera się w nowej karcie</span></a>
          <a href={site.links.faculty} target="_blank" rel="noopener noreferrer"><span><small>WYDZIAŁ</small><strong>Wydział Elektryczny</strong></span><Icon name="arrow-up-right" size={24} /><span class="sr-only"> — otwiera się w nowej karcie</span></a>
          <a href="/laboratorium/"><span><small>ZAPLECZE NAUKOWE</small><strong>Laboratorium Technologii Teleinformatycznych i Fotoniki</strong></span><Icon name="arrow-up-right" size={24} /></a>
        </div>
      </div>
    </section>

    <section class="section about-cta" aria-labelledby="about-cta-heading"><div class="container cta-row"><div><p class="eyebrow">TWOJA CIEKAWOŚĆ MA ZNACZENIE</p><h2 id="about-cta-heading" class="section-heading">Znajdź swoją część spektrum.</h2></div><a class="button button-primary" href="/dolacz/">Jak dołączyć <Icon name="arrow-right" size={18} /></a></div></section>
  </main>
</BaseLayout>

<style>
  .about-split{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,7vw,7rem)}
  .about-copy{max-width:43rem}.about-copy p:first-child{font-size:1.35rem;line-height:1.65}.about-copy .text-link{margin-top:1rem}
  .fields-section{background:rgba(255,255,255,.025);border-block:1px solid rgba(255,255,255,.08)}
  .section-top{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:3rem}.section-note{max-width:19rem;line-height:1.7}
  .fields-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.field-card{padding:2rem;border:1px solid rgba(255,255,255,.12);border-radius:1rem;background:rgba(7,16,32,.6)}
  .field-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:3.5rem;color:#62dce8}.field-number{font:500 .75rem/1 monospace;color:#92a1b6}.field-card h3{font-size:1.4rem;margin-bottom:.85rem}.field-card p{line-height:1.8;margin:0}
  .context-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:4rem}.context-heading>p:last-child{max-width:24rem;line-height:1.8}.context-list{border-top:1px solid rgba(255,255,255,.16)}.context-list>a{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.65rem 0;border-bottom:1px solid rgba(255,255,255,.16);text-decoration:none;color:inherit}.context-list small{display:block;font-size:.65rem;letter-spacing:.13em;color:#92a1b6;margin-bottom:.6rem}.context-list strong{display:block;font-size:1.1rem;line-height:1.6;font-weight:500}.context-list :global(svg){flex-shrink:0;color:#62dce8}.context-list>a:hover strong{color:#62dce8}
  .about-cta{border-top:1px solid rgba(255,255,255,.08)}.cta-row{display:flex;justify-content:space-between;align-items:center;gap:2rem}.cta-row .section-heading{margin-bottom:0}
  @media(max-width:850px){.about-split,.context-grid{grid-template-columns:1fr;gap:2rem}.section-top{display:block}.section-note{max-width:none}.fields-grid{grid-template-columns:1fr}.field-top{margin-bottom:2rem}.cta-row{align-items:flex-start;flex-direction:column}}
</style>
