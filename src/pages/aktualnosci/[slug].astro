---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const articles = await getCollection('news', ({ data }) => data.published);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'news'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const date = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'long', timeZone: 'UTC' }).format(article.data.date);
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <main id="main-content">
    <PageIntro eyebrow="Aktualności SPEKTRUM" title={article.data.title} description={article.data.description} />
    <article class="section detail-section">
      <div class="container detail-container">
        <a class="text-link back-link" href="/aktualnosci/"><Icon name="arrow-right" /> Wszystkie aktualności</a>
        <p class="article-date"><time datetime={article.data.date.toISOString()}>{date}</time></p>
        {article.data.image && <img class="detail-image" src={article.data.image} alt={article.data.imageAlt!} width="1200" height="750" />}
        <div class="prose"><Content /></div>
        {article.data.tags.length > 0 && (
          <ul class="tags" aria-label="Tematy aktualności">
            {article.data.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
        )}
        <nav class="article-footer" aria-label="Nawigacja po aktualnościach">
          <a class="text-link" href="/aktualnosci/">Wróć do aktualności <Icon name="arrow-right" /></a>
          <a class="text-link" href="/dolacz/">Dołącz do SPEKTRUM <Icon name="arrow-up-right" /></a>
        </nav>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .detail-section { padding-top: 0; }
  .detail-container { max-width: 58rem; }
  .back-link { margin-bottom: 2rem; }
  .back-link :global(svg) { transform: rotate(180deg); }
  .article-date { margin: 0 0 2rem; color: var(--color-muted, #a6a9b6); font-size: .9rem; }
  .detail-image { display: block; width: 100%; height: auto; border-radius: 1rem; margin-bottom: 2.5rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .article-footer { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border, #303440); }
</style>
