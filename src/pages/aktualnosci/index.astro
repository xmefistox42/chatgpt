---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';

const articles = (await getCollection('news', ({ data }) => data.published)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const formatDate = (date: Date) => new Intl.DateTimeFormat('pl-PL', { dateStyle: 'long', timeZone: 'UTC' }).format(date);
---

<BaseLayout
  title="Aktualności"
  description="Aktualności Koła Naukowego SPEKTRUM: informacje o działalności, spotkaniach i postępach prac."
>
  <main id="main-content">
    <PageIntro
      eyebrow="Co słychać w SPEKTRUM"
      title="Aktualności"
      description="Wiadomości z życia koła, zapowiedzi spotkań i relacje z naszej pracy. Wszystko w jednym miejscu."
    />

    <section class="section news-section" aria-label="Wiadomości koła">
      <div class="container">
        {
          articles.length > 0 ? (
            <div class="news-list">
              {articles.map((article) => (
                <article class="panel news-card">
                  {article.data.image && (
                    <img class="news-image" src={article.data.image} alt={article.data.imageAlt!} loading="lazy" width="800" height="500" />
                  )}
                  <div class="news-body">
                    <time class="eyebrow" datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
                    <h2><a href={`/aktualnosci/${article.id}/`}>{article.data.title}</a></h2>
                    <p class="muted">{article.data.description}</p>
                    {article.data.tags.length > 0 && (
                      <ul class="tags" aria-label="Tematy aktualności">
                        {article.data.tags.map((tag) => <li class="tag">{tag}</li>)}
                      </ul>
                    )}
                    <a class="text-link" href={`/aktualnosci/${article.id}/`}>Czytaj dalej <Icon name="arrow-up-right" /></a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-state panel news-empty">
              <span class="empty-icon" aria-hidden="true"><Icon name="wave" /></span>
              <p class="eyebrow">Nastaw się na nową falę</p>
              <h2>Pierwsze wiadomości jeszcze przed nami.</h2>
              <p class="muted">
                W tym miejscu pojawią się informacje o spotkaniach, wydarzeniach
                i działaniach SPEKTRUM. Już teraz możesz poznać temat lasera
                femtosekundowego i sprawdzić, jak do nas dołączyć.
              </p>
              <div class="empty-actions">
                <a class="button button-primary" href="/dolacz/">Dołącz do SPEKTRUM <Icon name="arrow-up-right" /></a>
                <a class="button button-secondary" href="/laser-femtosekundowy/">Poznaj laser femtosekundowy <Icon name="arrow-right" /></a>
              </div>
            </div>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .news-section { padding-top: 0; }
  .news-list { display: grid; gap: 1.25rem; }
  .news-card { overflow: hidden; }
  .news-image { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; }
  .news-body { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; padding: clamp(1.5rem, 3vw, 2rem); }
  .news-body h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2rem); }
  .news-body h2 a { text-decoration: none; }
  .news-body p { margin: 0; max-width: 68ch; }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .news-empty { max-width: 62rem; margin-inline: auto; padding: clamp(2rem, 6vw, 5rem); }
  .empty-icon { display: inline-flex; margin-bottom: 1.5rem; color: var(--color-accent, #8cbaff); }
  .empty-icon :global(svg) { width: 2.75rem; height: 2.75rem; }
  .news-empty h2 { max-width: 27ch; margin: 0 0 1.25rem; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.15; }
  .news-empty > .muted { max-width: 65ch; }
  .empty-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  @media (min-width: 50rem) {
    .news-card:has(.news-image) { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1fr); }
    .news-image { height: 100%; min-height: 18rem; }
  }
</style>
