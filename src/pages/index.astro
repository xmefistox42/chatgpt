---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import OpticalBench from '../components/OpticalBench.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { supervisor } from '../data/team';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => data.published)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
const news = (await getCollection('news', ({ data }) => data.published)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
const fields = [
  {number:'01',icon:'spark',title:'Fotonika',text:'Poznajemy światło i możliwości, jakie daje kontrola nad jego właściwościami.',href:'/o-nas/'},
  {number:'02',icon:'optics',title:'Układy optyczne',text:'Od pojedynczej soczewki do układu, w którym każdy element ma znaczenie.',href:'/laboratorium/'},
  {number:'03',icon:'wave',title:'Technologie laserowe',text:'Odkrywamy naturę laserów i niezwykle krótki świat impulsów optycznych.',href:'/laser-femtosekundowy/'},
  {number:'04',icon:'network',title:'Telekomunikacja optyczna',text:'Sprawdzamy, jak światło staje się nośnikiem informacji.',href:'/o-nas/'},
];
---
<BaseLayout title="SPEKTRUM">
  <main id="main-content">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span>Studenckie Koło Naukowe · ZUT Szczecin</p>
        <h1 id="hero-title">SPEKTRUM<span aria-hidden="true">.</span></h1>
        <p class="hero-headline">Przekraczamy<br/> granice <span>światła.</span></p>
        <p class="hero-description">Poznaj świat fotoniki, laserów i ultrakrótkich impulsów. Łączymy naukową ciekawość z praktyką laboratoryjną na Zachodniopomorskim Uniwersytecie Technologicznym w Szczecinie.</p>
        <div class="hero-actions"><a class="button button-primary" href="#obszary">Poznaj nasze badania <Icon name="arrow-up-right" size={17}/></a><a class="hero-secondary" href="/dolacz/">Dołącz do SPEKTRUM <Icon name="arrow-right" size={16}/></a></div>
        <p class="hero-note"><span class="status-dot"></span>Mała skala czasu. Wielka przestrzeń do odkryć.</p>
      </div>
      <figure class="hero-visual">
        <div class="visual-heading"><span>ŚWIATŁO. W PEŁNYM SPEKTRUM.</span><span aria-hidden="true">01 / ∞</span></div>
        <div class="brand-art"><img src={site.brand.logo} alt="Logo SPEKTRUM: ultrakrótki impuls, soczewka i rozszczepione widmo światła" width={site.brand.width} height={site.brand.height} fetchpriority="high" decoding="async"/><span class="orbit orbit-one" aria-hidden="true"></span></div>
        <figcaption><span>Fotonika zaczyna się od ciekawości.</span><span class="visual-cross" aria-hidden="true">+</span></figcaption>
      </figure>
    </section>

    <div class="institute-bar"><div class="container institute-inner"><div><span class="institute-mark" aria-hidden="true">ZUT<span>↗</span></span><span>Wydział Elektryczny<br/><strong>Zachodniopomorski Uniwersytet Technologiczny w Szczecinie</strong></span></div><p>Laboratorium Technologii<br/>Teleinformatycznych i Fotoniki</p><a href="/o-nas/" aria-label="Poznaj SPEKTRUM na ZUT"><Icon name="arrow-up-right"/></a></div></div>

    <section class="section container intro-section" aria-labelledby="about-heading">
      <div><p class="eyebrow">01 / O SPEKTRUM</p><h2 id="about-heading">Tu ciekawość<br/>spotyka <span class="soft">eksperyment.</span></h2></div>
      <div class="intro-description"><p>Jesteśmy studenckim kołem naukowym, które patrzy na świat przez pryzmat światła. Interesuje nas to, co dzieje się między teorią a obserwacją.</p><p class="muted">Na Wydziale Elektrycznym ZUT poznajemy fotonikę, optykę i technologie laserowe. Uczymy się zadawać pytania, pracować z aparaturą i szukać własnych odpowiedzi.</p><a class="text-link" href="/o-nas/">Poznaj nas bliżej <Icon name="arrow-up-right" size={17}/></a></div>
    </section>

    <section class="section areas-section" id="obszary" aria-labelledby="areas-heading"><div class="container">
      <div class="section-top"><div><p class="eyebrow">02 / OBSZARY DZIAŁALNOŚCI</p><h2 id="areas-heading">Jedno światło.<br/>Wiele kierunków.</h2></div><p>Od podstawowych zjawisk<br/>po technologie, które łączą świat.</p></div>
      <div class="area-grid">{fields.map(field => <a class="area-card" href={field.href}><div class="area-card-top"><span>{field.number}</span><Icon name="arrow-up-right" size={17}/></div><span class="area-icon"><Icon name={field.icon} size={42}/></span><h3>{field.title}</h3><p>{field.text}</p><span class="area-bottom">Odkrywaj <span aria-hidden="true">↗</span></span></a>)}</div>
    </div></section>

    <section class="section laser-section container" aria-labelledby="laser-heading">
      <div class="laser-feature">
        <div class="laser-feature-copy"><p class="eyebrow"><span class="status-dot"></span>03 / NASZA WYJĄTKOWA PERSPEKTYWA</p><h2 id="laser-heading">Światło w skali,<br/> która zmienia<br/><span>perspektywę.</span></h2><p>Femtosekunda to jedna biliardowa sekundy. W tak krótkim czasie światło otwiera zupełnie nowe możliwości badania materii.</p><a href="/laser-femtosekundowy/" class="button button-secondary">Poznaj laser femtosekundowy <Icon name="arrow-up-right" size={17}/></a></div>
        <div class="laser-illustration"><span class="laser-unit">ULTRAKRÓTKIE IMPULSY</span><div class="time-scale">10<sup>−15</sup><span>s</span></div><span class="time-label">JEDNA FEMTOSEKUNDA</span><svg viewBox="0 0 560 180" fill="none" role="img" aria-label="Poglądowy motyw impulsu światła, nie pomiar"><defs><linearGradient id="hero-pulse"><stop stop-color="#4aa5ef" stop-opacity="0"/><stop offset=".4" stop-color="#6dd8ff"/><stop offset=".6" stop-color="#ac98ff"/><stop offset="1" stop-color="#9376f4" stop-opacity="0"/></linearGradient></defs><path d="M0 90h560" stroke="#33435e" stroke-width=".6"/><path d="M0 90h150l8-2 7 5 7-8 7 11 7-18 7 27 7-37 7 49 7-64 7 79 7-97 7 116 7-136 7 153 7-163 7 167 7-164 7 153 7-137 7 118 7-98 7 78 7-62 7 46 7-32 7 22 7-14 7 9 7-5 8 2h150" stroke="url(#hero-pulse)" stroke-width="2" class="pulse-line"/><path d="M165 90c60 0 57-78 115-78s55 78 115 78" stroke="#839bd2" stroke-width=".8" stroke-dasharray="3 6" opacity=".5"/></svg><span class="illustration-caption">Motyw graficzny impulsu · nie jest pomiarem</span></div>
        <div class="laser-feature-footer"><span class="tag">femto / piko</span><p>Dostęp do systemu generującego ultrakrótkie impulsy w Pracowni Urządzeń Fotonicznych ZUT.</p><Icon name="wave" size={25}/></div>
      </div>
    </section>

    <section class="section container lab-section" aria-labelledby="lab-heading"><OpticalBench/><div class="lab-copy"><p class="eyebrow">04 / LABORATORIUM</p><h2 id="lab-heading">Dobra teoria.<br/>Jeszcze lepsze pytania.</h2><p class="muted">Laboratorium Technologii Teleinformatycznych i Fotoniki to nasze zaplecze do poznawania świata optyki. Tu idee spotykają się z rzeczywistym układem pomiarowym.</p><div class="lab-tags"><span class="tag">Optyka</span><span class="tag">Fotonika</span><span class="tag">Technika laserowa</span></div><a href="/laboratorium/" class="text-link">Zajrzyj do laboratorium <Icon name="arrow-up-right" size={17}/></a></div></section>

    <section class="section updates-section"><div class="container">
      <section aria-labelledby="projects-heading">
        <div class="updates-heading projects-home-heading"><div><p class="eyebrow">05 / PROJEKTY</p><h2 id="projects-heading">Od pytania do odkrycia.</h2></div><a href="/projekty/" class="text-link">Wszystkie projekty <Icon name="arrow-up-right" size={18}/></a></div>
        {projects.length ? <div class="projects-home-grid">{projects.map(project => <ProjectCard project={project} headingLevel={3} />)}</div> : <div class="home-empty"><h3>Przestrzeń na nowe pomysły.</h3><p>Opisy projektów pojawią się tutaj wraz z potwierdzonymi materiałami.</p><a href="/projekty/" class="text-link">O projektach <Icon name="arrow-right" size={16}/></a></div>}
      </section>
      <section class="home-news-row" aria-labelledby="news-heading">
        <div><p class="eyebrow">06 / AKTUALNOŚCI</p><h2 id="news-heading">Co w naszym spektrum?</h2></div>
        <div>{news.length ? news.map(item => <article class="update-card"><time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('pl-PL')}</time><h3><a href={`/aktualnosci/${item.id}/`}>{item.data.title}</a></h3><p>{item.data.description}</p><a class="text-link" href={`/aktualnosci/${item.id}/`}>Czytaj dalej <Icon name="arrow-up-right" size={16}/></a></article>) : <div class="home-news-empty"><h3>Kolejny impuls już wkrótce.</h3><p>Wiadomości z życia koła, relacje z laboratorium i informacje o naszych działaniach pojawią się tu po przygotowaniu materiałów.</p><a href="/aktualnosci/" class="text-link">Przejdź do aktualności <Icon name="arrow-right" size={16}/></a></div>}</div>
      </section>
    </div></section>

    <section class="section container team-section" aria-labelledby="team-heading"><div><p class="eyebrow">07 / LUDZIE SPEKTRUM</p><h2 id="team-heading">Nauka zaczyna się<br/>od <span class="soft">ludzi.</span></h2></div><div class="team-description"><p class="muted">Łączy nas ciekawość fotoniki i chęć zrozumienia, jak działa światło. Opiekun naszego koła bada optykę nieliniową i materiały fotorefrakcyjne, łącząc teorię z eksperymentem.</p><div class="supervisor-mini"><span aria-hidden="true">AZ</span><div><p><a href={supervisor.profileUrl}>{supervisor.name}</a></p><small>Opiekun naukowy SPEKTRUM</small></div></div><div class="team-profile-links"><a href={supervisor.profileUrl} class="text-link">Poznaj opiekuna <Icon name="arrow-up-right" size={17}/></a><a href="/zespol/" class="text-link">Nasz zespół <Icon name="arrow-right" size={17}/></a></div></div></section>

    <section class="join-section" aria-labelledby="join-heading"><div class="container join-inner"><div class="join-orbit" aria-hidden="true"></div><p class="eyebrow">08 / TWÓJ KOLEJNY KROK</p><h2 id="join-heading">Masz w sobie<br/><span>iskrę ciekawości?</span></h2><p>Nie musisz znać wszystkich odpowiedzi.<br/>Wystarczy, że chcesz zadawać pytania.</p><a href="/dolacz/" class="button button-primary">Dołącz do SPEKTRUM <Icon name="arrow-up-right" size={18}/></a><a href="/kontakt/" class="join-contact">Chcesz nas poznać? Przejdź do kontaktu <span aria-hidden="true">↗</span></a></div></section>
  </main>
</BaseLayout>

<style>
  .hero{display:grid;grid-template-columns:1.07fr 1fr;gap:40px;align-items:center;padding-top:72px;padding-bottom:76px;min-height:650px}.hero-copy{position:relative;z-index:1;min-width:0}.hero .eyebrow{font-size:9px;letter-spacing:.15em;margin-bottom:28px}.hero h1{font-size:clamp(60px,6.45vw,93px);line-height:1;margin:0 0 24px;letter-spacing:-.055em}.hero h1>span{color:var(--cyan)}.hero-headline{font:400 clamp(32px,3.3vw,48px)/1.12 var(--font-heading);letter-spacing:-.04em;margin-bottom:25px}.hero-headline>span{color:var(--cyan)}.hero-description{color:#aab9ce;max-width:470px;font-size:14px;line-height:1.95;margin-bottom:30px}.hero-actions{display:flex;align-items:center;gap:25px;flex-wrap:wrap}.hero-actions .button{font-size:12px;padding-inline:18px;gap:20px}.hero-secondary{font-size:12px;font-weight:600;display:inline-flex;gap:12px;align-items:center;min-height:44px}.hero-secondary svg{color:var(--cyan)}.hero-note{display:flex;align-items:center;gap:9px;font-size:10px;color:#9daec6;margin:32px 0 0}.hero-note .status-dot{width:4px;height:4px}.hero-visual{margin:0;min-width:0;position:relative;padding:0 0 12px}.visual-heading{display:flex;justify-content:space-between;font-size:8px;letter-spacing:.16em;color:#a2b2ca;padding-inline:4px}.visual-heading>span:last-child{color:var(--cyan)}.brand-art{position:relative;isolation:isolate;margin-block:7px 0}.brand-art img{width:100%;height:auto;mix-blend-mode:screen}.hero-visual figcaption{display:flex;justify-content:space-between;align-items:center;color:#a2b2ca;font-size:9px;letter-spacing:.02em;padding:14px 4px 0;border-top:1px solid #253047}.visual-cross{font-size:21px;color:var(--cyan)}.institute-bar{border-block:1px solid var(--line);background:#0b1526}.institute-inner{display:flex;align-items:center;justify-content:space-between;gap:40px;padding-block:24px}.institute-inner>div{display:flex;align-items:center;gap:26px}.institute-mark{font:600 26px var(--font-heading);letter-spacing:-.04em}.institute-mark>span{display:inline-block;color:var(--cyan);margin-left:6px;font-size:19px}.institute-inner>div>span:last-child{font-size:9px;line-height:1.9;color:#d5dfef}.institute-inner strong{font-weight:400;color:#a8b8cf;font-size:9px}.institute-inner>p{font-size:10px;line-height:1.75;color:#a8b8cf;margin:0 0 0 auto}.institute-inner>a{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;border-left:1px solid var(--line);padding-left:30px;color:var(--cyan)}.intro-section{display:grid;grid-template-columns:1fr 1fr;gap:90px;padding-bottom:90px}.intro-section h2{margin-bottom:0}.soft{color:#9daec7}.intro-description{padding-top:34px;max-width:490px}.intro-description>p:first-child{font-size:17px;line-height:1.85}.intro-description>p.muted{font-size:14px}.areas-section{background:#0a1425;border-top:1px solid #1e2a3f;padding-top:76px;padding-bottom:86px;scroll-margin-top:85px}.section-top{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:38px}.section-top h2{margin-bottom:0}.section-top>p{color:var(--muted);font-size:12px;margin-bottom:5px}.area-grid{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line);border-left:1px solid var(--line)}.area-card{padding:24px 25px 22px;border-right:1px solid var(--line);display:flex;flex-direction:column;transition:background .2s;background:#0c1729}.area-card:hover{background:#142037;color:#fff}.area-card-top{display:flex;justify-content:space-between;color:#9aabc4;font-size:9px}.area-card-top svg{color:#9aabc4}.area-icon{display:flex;align-items:center;height:116px;color:#82cfee}.area-card:nth-child(2) .area-icon{color:#a5b7fb}.area-card:nth-child(3) .area-icon{color:#b2a0fa}.area-card h3{font-size:20px;line-height:1.25;min-height:50px;margin-bottom:14px;letter-spacing:-.035em}.area-card p{font-size:13px;line-height:1.9;color:#a8b8ce;flex:1;margin-bottom:26px}.area-bottom{border-top:1px solid #26344a;padding-top:15px;display:flex;justify-content:space-between;font-size:10px;font-weight:500;color:#cbd9ee}.area-bottom>span{color:var(--cyan)}.laser-section{padding-block:90px 50px}.laser-feature{display:grid;grid-template-columns:1fr 1fr;border:1px solid #344261;background:radial-gradient(ellipse at 77% 40%,#18203e80,transparent 65%),#0b1528;position:relative;overflow:hidden}.laser-feature:before{content:'';position:absolute;left:0;top:0;width:32%;height:1px;background:linear-gradient(90deg,var(--cyan),#a798ef,transparent)}.laser-feature-copy{padding:50px 0 46px 48px;position:relative;z-index:1}.laser-feature-copy>.eyebrow{font-size:8px;letter-spacing:.12em;gap:8px;margin-bottom:25px}.laser-feature-copy h2{font-size:clamp(30px,3.5vw,48px);margin-bottom:22px}.laser-feature-copy h2>span{color:var(--violet)}.laser-feature-copy>p:not(.eyebrow){font-size:14px;color:#aab9d0;max-width:350px;line-height:1.9;margin-bottom:25px}.laser-feature-copy .button{font-size:10px;padding:11px 16px;gap:24px;border-color:#4e5274;min-height:46px}.laser-illustration{position:relative;align-self:center;text-align:center;padding-top:12px}.laser-unit{display:block;font-size:8px;letter-spacing:.2em;color:#adb8d3}.time-scale{font:400 130px/1.25 var(--font-heading);letter-spacing:-.06em;color:#e5e9ff;position:relative;display:inline-flex;align-items:baseline;margin:35px 0 0}.time-scale sup{font-size:44px;position:static;align-self:flex-start;margin-top:8px;margin-left:5px;letter-spacing:-.04em;color:#afa7eb}.time-scale>span{font:18px var(--font-heading);margin-left:18px;color:#a7a9d4;letter-spacing:0}.time-label{display:block;font-size:8px;letter-spacing:.18em;color:#b4adcf}.laser-illustration svg{width:100%;height:auto;max-height:150px;margin-top:4px}.pulse-line{stroke-dasharray:1800;stroke-dashoffset:1800;animation:trace 4s ease-out forwards}.illustration-caption{font-size:8px;color:#a2abc5;display:block;margin-bottom:24px}.laser-feature-footer{grid-column:1/-1;border-top:1px solid #2a3551;display:flex;align-items:center;padding:18px 35px;gap:18px;background:#111b3070}.laser-feature-footer .tag{white-space:nowrap;color:#bdb2ec;border-color:#444267;font-size:9px}.laser-feature-footer p{font-size:11px;margin:0;color:#b5bfd5;max-width:660px}.laser-feature-footer>svg{color:#a29bdd;margin-left:auto}.lab-section{display:grid;grid-template-columns:1fr 1fr;gap:75px;align-items:center;padding-top:40px;padding-bottom:95px}.lab-copy{max-width:430px}.lab-copy h2{font-size:38px}.lab-copy>.muted{font-size:14px;line-height:1.95}.lab-tags{display:flex;flex-wrap:wrap;gap:7px;margin-block:24px 14px}.lab-tags .tag{font-size:9px}.updates-section{border-top:1px solid var(--line);background:#0a1424;padding-block:80px}.updates-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px}.updates-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:30px}.updates-heading h2{font-size:28px;margin-bottom:0}.updates-heading .eyebrow{font-size:9px;margin-bottom:16px}.square-link{border:1px solid #3b4960;width:40px;min-width:40px;height:40px;display:flex;align-items:center;justify-content:center;color:var(--cyan)}.home-empty{border-block:1px solid var(--line);padding:28px 0 14px}.empty-cross{width:44px;height:44px;display:flex;align-items:center;justify-content:center;background:#152139;color:#93a8ca;margin-bottom:22px}.home-empty h3{font-size:20px;margin-bottom:13px}.home-empty>p{font-size:14px;color:#a8b7cd;max-width:390px;line-height:1.95;margin-bottom:14px}.home-empty .text-link{font-size:10px}.update-card{padding-block:24px;border-top:1px solid var(--line)}.update-card h3{font-size:24px;margin:16px 0 14px}.update-card p,.update-card time{font-size:12px;color:var(--muted)}.team-section{display:grid;grid-template-columns:1fr 1fr;gap:90px}.team-section h2{font-size:42px;margin-bottom:0}.team-description{padding-top:25px}.team-description>p{font-size:14px;line-height:1.9;max-width:440px}.supervisor-mini{display:flex;align-items:center;gap:16px;padding-block:18px;margin-bottom:8px}.supervisor-mini>span{font:400 20px var(--font-heading);color:#aac2e6;display:flex;align-items:center;justify-content:center;width:52px;height:52px;background:#17243a;border:1px solid #33435c}.supervisor-mini p{font-size:12px;margin:0}.supervisor-mini small{font-size:10px;color:#a1b0c7}.join-section{position:relative;border-top:1px solid var(--line);overflow:hidden;background:radial-gradient(ellipse at 50% 100%,#1a2550,transparent 75%),#0b1428}.join-inner{text-align:center;position:relative;isolation:isolate;padding-block:85px 80px}.join-inner>.eyebrow{justify-content:center;font-size:9px}.join-inner h2{font-size:clamp(40px,5vw,66px);margin-bottom:22px}.join-inner h2>span{color:#b4c8ed}.join-inner>p:not(.eyebrow){font-size:13px;color:#acbbd3;margin-bottom:28px}.join-inner .button{font-size:11px;padding-inline:24px}.join-contact{display:block;width:fit-content;margin:23px auto 0;font-size:10px;color:#aebed6;padding-block:10px}.join-contact span{color:var(--cyan);margin-left:8px}.join-orbit{width:680px;height:680px;position:absolute;z-index:-1;bottom:-515px;left:calc(50% - 340px);border:1px solid #40518366;border-radius:50%}.join-orbit:after{content:'';position:absolute;inset:-55px;border:1px solid #40518333;border-radius:50%}@keyframes trace{to{stroke-dashoffset:0}}
